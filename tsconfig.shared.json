    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist/shared",
    "rootDir": "src/shared",
    "tsBuildInfoFile": "dist/.tsbuildinfo/shared"
